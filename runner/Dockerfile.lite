# job-runner:lite — default job image. Python + git + pytest + node.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir httpx pytest

RUN useradd -m -u 1000 agent && mkdir -p /workspace && chown agent:agent /workspace

COPY runner.py /opt/runner/runner.py

USER agent
WORKDIR /workspace
ENTRYPOINT ["python", "/opt/runner/runner.py"]
